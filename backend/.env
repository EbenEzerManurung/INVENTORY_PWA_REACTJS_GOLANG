# Server
PORT=5000
GIN_MODE=debug

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db
DB_PORT=3306

# JWT
JWT_SECRET=your_super_secret_key_here_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_67890
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Seeder
RUN_SEEDER=true

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2097152